{
  "name": "landing-analitica",
  "version": "0.1.0",
  "description": "Painel analítico com menus, gráficos e relatórios para download (Angular 20).",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless",
    "e2e": "npm --prefix e2e test",
    "docs:inventory": "node scripts/docs-inventory.js",
    "docs:check": "node scripts/docs-check.js",
    "rules:check": "bash .rules/check.sh",
    "hooks:install": "git config core.hooksPath .githooks",
    "verify": "npm run docs:check && npm run rules:check && npm run build:prod && npm run test:ci"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "20.3.14",
    "@angular/cdk": "20.2.14",
    "@angular/common": "20.3.14",
    "@angular/compiler": "20.3.14",
    "@angular/core": "20.3.14",
    "@angular/forms": "20.3.14",
    "@angular/language-service": "20.3.14",
    "@angular/platform-browser": "20.3.14",
    "@angular/platform-browser-dynamic": "20.3.14",
    "@angular/router": "20.3.14",
    "@coreui/angular": "5.5.24",
    "@coreui/angular-chartjs": "5.5.24",
    "@coreui/chartjs": "4.1.0",
    "@coreui/coreui": "5.4.3",
    "@coreui/icons": "3.0.1",
    "@coreui/icons-angular": "5.5.24",
    "@coreui/utils": "2.0.2",
    "@fontsource/inter": "5.3.0",
    "chart.js": "4.5.1",
    "exceljs": "4.4.0",
    "ngx-scrollbar": "13.0.3",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular/build": "20.3.12",
    "@angular/cli": "20.3.12",
    "@angular/compiler-cli": "20.3.14",
    "@angular/localize": "20.3.14",
    "@types/jasmine": "5.1.13",
    "@types/node": "22.19.1",
    "jasmine-core": "5.12.1",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.1.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "^22.12.0",
    "npm": ">= 10.9.4"
  }
}
