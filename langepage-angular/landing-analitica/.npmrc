# npm registry of the project (corporate rule: .npmrc pointing to the npm proxy of the Nexus, always-auth).
# No host and no credential is versioned here (R6): the pipeline sets NPM_REGISTRY from a Jenkins credential and
# the registry token in its own user config (NPM_CONFIG_USERCONFIG). See docs/dependencias-e-ambiente.md section 1.4.
registry=${NPM_REGISTRY}
# Workstation without NPM_REGISTRY (npm >= 11.6 only): "${NPM_REGISTRY?}" is empty when the variable is unset, so this
# key turns into "registry" and, being the last one, wins with the public registry. With the variable set, the key is
# not a config name and npm ignores it (warning "Unknown project config"). npm 10 has no "?" syntax: export NPM_REGISTRY.
registry${NPM_REGISTRY?}=https://registry.npmjs.org/
always-auth=true
